{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "python -m pip install --target .python-packages ytconverter"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg"],
    "startCommand": "PYTHONPATH=/app/.python-packages PATH=/app/.python-packages/bin:$PATH npm start"
  }
}

