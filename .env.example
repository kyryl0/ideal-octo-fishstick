BOT_TOKEN=123456:replace-me
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me

# Optional: raises Song.link/Odesli API rate limits for cross-platform links.
# SONGLINK_API_KEY=replace-me

# Optional licensed Spotify downloader backend.
# Keep these unset to use the SoundHelix test-audio fallback.
# AUDIO_PROVIDER=licensed_spotify
# LICENSED_SPOTIFY_MODULE=replace-with-nda-module-import-specifier
# LICENSED_SPOTIFY_INSTALL_SPEC=replace-with-npm-or-git-install-specifier
# LICENSED_SPOTIFY_COOKIE=sp_dc=replace-me
#
# The example downloader returns Ogg Vorbis. Telegram may reject OGG as
# InputMediaAudio, so the bot retries as a document automatically if needed.
# LICENSED_TELEGRAM_MEDIA_TYPE=audio

# Railway sets PORT automatically. Railway also exposes RAILWAY_PUBLIC_DOMAIN
# after you generate a public domain, so PUBLIC_BASE_URL is optional there.
# For local development only, set these yourself:
# PUBLIC_BASE_URL=https://your-public-https-url.example
# PORT=3000
