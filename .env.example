BOT_TOKEN=123456:replace-me
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me

# Optional: raises Song.link/Odesli API rate limits for cross-platform links.
# SONGLINK_API_KEY=replace-me

# Optional Spooty downloader backend.
# Keep these unset to use the SoundHelix test-audio fallback.
# AUDIO_PROVIDER=spooty
# SPOOTY_BASE_URL=https://your-spooty-service.example.com
# SPOOTY_AUDIO_EXTENSION=mp3
# SPOOTY_POLL_INTERVAL_MS=3000
# SPOOTY_POLL_TIMEOUT_MS=180000
# TELEGRAM_MEDIA_TYPE=audio

# Spooty service only: YouTube/yt-dlp tuning.
# Prefer base64 so Railway preserves the exact Netscape cookies.txt file.
# YT_COOKIES_FILE_BASE64=base64-encoded-cookies-txt
# YT_COOKIES_FILE_CONTENT=pasted-cookies-txt
# YT_COOKIES=pasted-cookies-txt
# YTDLP_VERBOSE=true
# YTDLP_DOWNLOAD_EXTRACTOR_ARGS=youtube:player_client=mweb

# Railway sets PORT automatically. Railway also exposes RAILWAY_PUBLIC_DOMAIN
# after you generate a public domain, so PUBLIC_BASE_URL is optional there.
# For local development only, set these yourself:
# PUBLIC_BASE_URL=https://your-public-https-url.example
# PORT=3000
